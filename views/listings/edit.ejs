<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing | WanderLust</title>
</head>

<body>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
        <h3>Edit your Listing</h3>

        <!-- Title -->
        <input name="listing[title]" value="<%= listing.title %>" required>
        <br><br>

        <!-- Description -->
        <textarea name="listing[description]" placeholder="Enter Description"
            required><%= listing.description %></textarea>
        <br><br>

        <!-- Image URL -->
        <input name="listing[image][url]" value="<%= listing.image && listing.image.url ? listing.image.url : '' %>"
            placeholder="Enter Image URL">
        <br><br>

        <!-- Price -->
        <input type="number" name="listing[price]" value="<%= listing.price %>" min="0" required>
        <br><br>

        <!-- Location -->
        <input name="listing[location]" value="<%= listing.location %>" required>
        <br><br>

        <!-- Country -->
        <input name="listing[country]" value="<%= listing.country %>" required>
        <br><br>

        <button type="submit">Edit</button>
    </form>
</body>

</html>