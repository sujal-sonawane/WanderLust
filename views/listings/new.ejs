<!DOCTYPE html>
<html lang="en">

<head>
       <meta charset="UTF-8">
       <meta name="viewport" content="width=device-width, initial-scale=1.0">
       <title>Wanderlust</title>
</head>

<body>
       <form action="/listings" method="POST">
              <h3>Create a new listing</h3>

              <input name="listing[title]" placeholder="Enter Title" required>
              <br><br>

              <textarea name="listing[description]" placeholder="Enter Description"></textarea>
              <br><br>

              <input name="listing[image][url]" placeholder="Enter Image URL/LINK">
              <br><br>

              <input type="number" name="listing[price]" placeholder="Enter Price" min="0" required>
              <br><br>

              <input name="listing[location]" placeholder="Enter Location" required>
              <br><br>

              <input name="listing[country]" placeholder="Enter Country Name" required>
              <br><br>

              <button type="submit">Add</button>
       </form>
</body>
</body>

</html>